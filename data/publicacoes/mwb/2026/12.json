            "conteudo": [
                {
                    "tipo": "subtema",
                    "texto": "Cântico 71 e oração | Comentários iniciais"
                },
                {
                    "tipo": "subtema",
                    "texto": "EZEQUIEL 3-4"
                },
                {
                    "tipo": "subtema",
                    "texto": "💎 TESOUROS DA PALAVRA DE DEUS"
                },
                {
                    "tipo": "subtema",
                    "texto": "1. Porque é que nós não temos medo de pregar?"
                },
                {
                    "tipo": "paragrafo",
                    "texto": "A nossa força vem de Jeová. (Eze. 3:8, 9; w22.11 5 §§ 10-11)",
                    "numero_ref": "1"
                },
                {
                    "tipo": "paragrafo",
                    "texto": "A nossa mensagem vem de Jeová. (Eze. 3:10, 11; bt 134 § 7)",
                    "numero_ref": "2"
                },
                {
                    "tipo": "paragrafo",
                    "texto": "O nosso trabalho pode salvar vidas. (Eze. 3:18, 19; 1 Tim. 4:16; w18.05 19 §§ 8-9)",
                    "numero_ref": "3"
                },
                {
                    "tipo": "subtema",
                    "texto": "2. Pérolas espirituais"
                },
                {
                    "tipo": "paragrafo",
                    "texto": "Eze. 4:12-15 — Jeová estava disposto a escutar Ezequiel. O que é que aprendemos com isso? (w94-T 1/8 13 §§ 14-15)",
                    "numero_ref": "4"
                },
                {
                    "tipo": "paragrafo",
                    "texto": "Que pérolas espirituais encontrou na leitura da Bíblia desta semana?",
                    "numero_ref": "5"
                },
                {
                    "tipo": "subtema",
                    "texto": "3. Leitura da Bíblia"
                },
                {
                    "tipo": "paragrafo",
                    "texto": "Eze. 3:16-27 (th lição 2)",
                    "numero_ref": "6"
                },
                {
                    "tipo": "subtema",
                    "texto": "🌾 EMPENHE-SE NO MINISTÉRIO"
                },
                {
                    "tipo": "subtema",
                    "texto": "4. Iniciar conversas"
                },
                {
                    "tipo": "paragrafo",
                    "texto": "DE CASA EM CASA. Fale sobre uma verdade da Bíblia. Talvez possa usar uma das verdades que estão no apêndice A da brochura Ame as Pessoas. (lmd lição 1 ponto 5)",
                    "numero_ref": "7"
                },
                {
                    "tipo": "subtema",
                    "texto": "5. Iniciar conversas"
                },
                {
                    "tipo": "paragrafo",
                    "texto": "TESTEMUNHO PÚBLICO. A pessoa ouviu dizer que as Testemunhas de Jeová são uma seita. (lmd lição 9 ponto 4)",
                    "numero_ref": "8"
                },
                {
                    "tipo": "subtema",
                    "texto": "6. Fazer discípulos"
                },
                {
                    "tipo": "paragrafo",
                    "texto": "Fale com o seu estudante sobre limpeza. (lmd lição 12 ponto 4)",
                    "numero_ref": "9"
                },
                {
                    "tipo": "subtema",
                    "texto": "🐑 VIVER COMO CRISTÃOS"
                },
                {
                    "tipo": "subtema",
