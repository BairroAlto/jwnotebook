                }
            ]
        },
        {
            "referencia": "mwb26 novembro dezembro pp. 10-11",
            "titulo": "14 A 20 DE DEZEMBRO",
            "conteudo": [
                {
                    "tipo": "subtema",
                    "texto": "Cântico 49 e oração | Comentários iniciais"
                },
                {
                    "tipo": "subtema",
                    "texto": "EZEQUIEL 5-6"
                },
                {
                    "tipo": "subtema",
                    "texto": "💎 TESOUROS DA PALAVRA DE DEUS"
                },
                {
                    "tipo": "subtema",
                    "texto": "1. Pessoas que adoram ídolos magoam a Jeová"
                },
                {
                    "tipo": "paragrafo",
                    "texto": "O povo abandonou a Jeová e começou a adorar ídolos. (Eze. 5:11)",
                    "numero_ref": "1"
                },
                {
                    "tipo": "paragrafo",
                    "texto": "Jeová ficou muito magoado com o que eles fizeram. (Eze. 6:9; w04-T 15/5 6 §§ 3-4)",
                    "numero_ref": "2"
                },
                {
                    "tipo": "paragrafo",
                    "texto": "Os cristãos precisam de ‘fugir da idolatria’. (1 Cor. 10:14; rr 54 § 9)",
                    "numero_ref": "3"
                },
                {
                    "tipo": "subtema",
                    "texto": "2. Pérolas espirituais"
                },
                {
                    "tipo": "paragrafo",
                    "texto": "Eze. 5:1, 2 — Qual era o significado do que Ezequiel fez com o seu cabelo? (rr 63 § 6)",
                    "numero_ref": "4"
                },
                {
                    "tipo": "paragrafo",
                    "texto": "Que pérolas espirituais encontrou na leitura da Bíblia desta semana?",
                    "numero_ref": "5"
                },
                {
                    "tipo": "subtema",
                    "texto": "3. Leitura da Bíblia"
                },
                {
                    "tipo": "paragrafo",
                    "texto": "Eze. 6:1-10 (th lição 5)",
                    "numero_ref": "6"
                },
                {
                    "tipo": "subtema",
                    "texto": "🌾 EMPENHE-SE NO MINISTÉRIO"
                },
                {
                    "tipo": "subtema",
                    "texto": "4. Iniciar conversas"
                },
                {
                    "tipo": "paragrafo",
                    "texto": "TESTEMUNHO PÚBLICO. A pessoa quer discutir consigo. (lmd lição 4 ponto 5)",
                    "numero_ref": "7"
                },
                {
                    "tipo": "subtema",
                    "texto": "5. Cultivar o interesse"
                },
                {
                    "tipo": "paragrafo",
                    "texto": "DE CASA EM CASA. Ofereça uma revista sobre o assunto que falaram na conversa anterior. (lmd lição 9 ponto 4)",
                    "numero_ref": "8"
                },
                {
                    "tipo": "subtema",
                    "texto": "6. O que diria?"
                },
                {
                    "tipo": "subtema",
                    "texto": "Discurso com participação da assistência. DE CASA EM CASA. Faça um resumo da brochura Ame as Pessoas, lição 1, ponto 4b. Mostre a imagem. Depois, pergunte:"
                },
                {
                    "tipo": "paragrafo",
                    "texto": "De acordo com o que vê na imagem, o que diria para iniciar uma conversa?",
                    "numero_ref": "9"
                },
                {
                    "tipo": "paragrafo",
                    "texto": "Que verdade da Bíblia é que poderia mostrar?",
                    "numero_ref": "10"
                },
                {
                    "tipo": "subtema",
                    "texto": "🐑 VIVER COMO CRISTÃOS"
                },
                {
                    "tipo": "subtema",
                    "texto": "Cântico 153"
                },
                {
                    "tipo": "subtema",
                    "texto": "7. Porque é que não participamos em cerimónias nacionais?"
                },
                {
                    "tipo": "subtema",
                    "texto": "Discurso com participação da assistência."
                },
                {
                    "tipo": "paragrafo",
                    "texto": "Os cristãos devem evitar qualquer tipo de idolatria. Por exemplo, nós não participamos em cerimónias nacionais, porque isso envolve adorar algo ou alguém que não é Jeová Deus. (Mat. 4:10) Ao assistir ao vídeo a seguir, pense em cerimónias nacionais que são comuns na sua região.",
                    "numero_ref": "11"
                },
                {
                    "tipo": "paragrafo",
                    "texto": "Mostre o VÍDEO Mantenha-se Neutro em Eventos Públicos. Depois, pergunte:",
                    "numero_ref": "12"
                },
                {
                    "tipo": "paragrafo",
                    "texto": "Que bons exemplos é que podemos imitar?",
                    "numero_ref": "13"
                },
                {
                    "tipo": "paragrafo",
                    "texto": "Como é que as famílias se podem preparar para não serem apanhadas de surpresa?",
                    "numero_ref": "14"
                },
                {
                    "tipo": "paragrafo",
                    "texto": "Que informações úteis é que encontrou sobre este assunto em publicações ou vídeos da organização?",
                    "numero_ref": "15"
                },
                {
                    "tipo": "subtema",
                    "texto": "8. Estudo bíblico de congregação"
                },
                {
                    "tipo": "paragrafo",
                    "texto": "wcg cap. 21",
                    "numero_ref": "16"
                },
                {
                    "tipo": "rodape",
                    "texto": "Comentários finais | Cântico 133 e oração"
                }
            ]
        },
        {
            "referencia": "mwb26 novembro dezembro pp. 12-13",
            "titulo": "21 A 27 DE DEZEMBRO",
            "conteudo": [
                {
                    "tipo": "subtema",
                    "texto": "Cântico 128 e oração | Comentários iniciais"
                },
                {
                    "tipo": "subtema",
                    "texto": "EZEQUIEL 7-8"
                },
                {
                    "tipo": "subtema",
                    "texto": "💎 TESOUROS DA PALAVRA DE DEUS"
                },
                {
                    "tipo": "subtema",
                    "texto": "1. O dia de Jeová virá no momento certo"
                },
                {
                    "tipo": "paragrafo",
                    "texto": "Jeová age sempre no momento certo. (Eze. 7:3; rr 66-68 §§ 13-15)",
                    "numero_ref": "1"
                },
                {
                    "tipo": "paragrafo",
                    "texto": "Jeová escolheu um dia específico para destruir os israelitas. Ele cumpriu esse propósito, porque eles continuaram a fazer coisas erradas. (Eze. 7:4, 10)",
                    "numero_ref": "2"
                },
                {
                    "tipo": "paragrafo",
                    "texto": "Usamos o nosso tempo de forma sábia, porque sabemos que o dia de Jeová não se vai atrasar. (rr 70 § 19)",
                    "numero_ref": "3"
                },
                {
                    "tipo": "paragrafo",
                    "texto": "Usamos o nosso tempo de forma sábia, quando pregamos em horários em que podemos encontrar mais pessoas",
                    "numero_ref": "4"
                },
                {
                    "tipo": "subtema",
                    "texto": "2. Pérolas espirituais"
                },
                {
                    "tipo": "paragrafo",
                    "texto": "Eze. 7:19 — Em que sentido é que esta profecia se vai cumprir, e qual é a lição para nós? (w24.09 11 § 14)",
                    "numero_ref": "5"
                },
                {
                    "tipo": "paragrafo",
                    "texto": "Que pérolas espirituais encontrou na leitura da Bíblia desta semana?",
                    "numero_ref": "6"
                },
                {
                    "tipo": "subtema",
                    "texto": "3. Leitura da Bíblia"
                },
                {
                    "tipo": "paragrafo",
                    "texto": "Eze. 8:7-18 (th lição 2)",
                    "numero_ref": "7"
                },
                {
                    "tipo": "subtema",
                    "texto": "🌾 EMPENHE-SE NO MINISTÉRIO"
                },
                {
                    "tipo": "subtema",
                    "texto": "4. Iniciar conversas"
                },
                {
                    "tipo": "paragrafo",
                    "texto": "DE CASA EM CASA. (lmd lição 1 ponto 4)",
                    "numero_ref": "8"
                },
                {
                    "tipo": "subtema",
                    "texto": "5. Cultivar o interesse"
                },
                {
                    "tipo": "paragrafo",
                    "texto": "DE CASA EM CASA. A pessoa com quem falou da última vez não está em casa. Converse com um familiar dela. (lmd lição 9 ponto 3)",
                    "numero_ref": "9"
                },
                {
                    "tipo": "subtema",
                    "texto": "6. Fazer discípulos"
                },
                {
                    "tipo": "paragrafo",
                    "texto": "Ajude o seu estudante a preparar-se para dar testemunho a um familiar. (lmd lição 12 ponto 3)",
                    "numero_ref": "10"
                },
                {
                    "tipo": "subtema",
                    "texto": "🐑 VIVER COMO CRISTÃOS"
                },
                {
                    "tipo": "subtema",
                    "texto": "Cântico 139"
                },
                {
                    "tipo": "subtema",
                    "texto": "7. Pense nas consequências"
                },
                {
                    "tipo": "subtema",
                    "texto": "Discurso com participação da assistência."
                },
                {
                    "tipo": "paragrafo",
                    "texto": "Jeová disse aos israelitas infiéis: “Trarei sobre ti os efeitos dos teus próprios caminhos, e sofrerás as consequências das tuas ações detestáveis.” (Eze. 7:4) Que lição é que podemos tirar deste texto?",
                    "numero_ref": "11"
                },
                {
                    "tipo": "paragrafo",
                    "texto": "É sábio pensar nas consequências antes de agir. (Deut. 32:29) Por exemplo, quando temos vontade de fazer alguma coisa errada, devemos parar e pensar: ‘Que consequências é que eu posso ter, se fizer isto? Se eu continuar leal a Jeová, que bênçãos é que terei?’ — Isa. 59:2.",
                    "numero_ref": "12"
                },
                {
                    "tipo": "paragrafo",
                    "texto": "Leia Provérbios 27:11 e Filipenses 4:7. Depois, pergunte:",
                    "numero_ref": "13"
                },
                {
                    "tipo": "paragrafo",
                    "texto": "Que bênçãos é que temos por nos mantermos leais a Jeová?",
                    "numero_ref": "14"
                },
                {
                    "tipo": "paragrafo",
                    "texto": "Leia o Salmo 38:3-8. Depois, pergunte:",
                    "numero_ref": "15"
                },
                {
                    "tipo": "paragrafo",
                    "texto": "Que más consequências é que podemos ter, se fizermos alguma coisa errada?",
                    "numero_ref": "16"
                },
                {
                    "tipo": "paragrafo",
                    "texto": "Uma mulher faz um trilho. Ela encontra dois caminhos diferentes.",
                    "numero_ref": "17"
                },
                {
                    "tipo": "paragrafo",
                    "texto": "Mostre o VÍDEO Imagina Um mundo sem Dor. Depois, pergunte:",
                    "numero_ref": "18"
                },
                {
                    "tipo": "paragrafo",
                    "texto": "Que outras bênçãos é que quer receber no novo mundo?",
                    "numero_ref": "19"
                },
                {
                    "tipo": "subtema",
                    "texto": "8. Estudo bíblico de congregação"
                },
                {
                    "tipo": "paragrafo",
                    "texto": "wcg introdução da secção 2, linha do tempo e cap. 22",
                    "numero_ref": "20"
                },
                {
                    "tipo": "rodape",
                    "texto": "Comentários finais | Cântico 154 e oração"
                }
            ]
        },
        {
            "referencia": "mwb26 novembro dezembro pp. 14-15",
            "titulo": "28 DE DEZEMBRO DE 2026 A 3 DE JANEIRO DE 2027",
            "conteudo": [
                {
                    "tipo": "subtema",
                    "texto": "Cântico 119 e oração | Comentários iniciais"
                },
                {
                    "tipo": "subtema",
                    "texto": "EZEQUIEL 9-10"
                },
                {
                    "tipo": "subtema",
                    "texto": "💎 TESOUROS DA PALAVRA DE DEUS"
                },
                {
                    "tipo": "paragrafo",
                    "texto": "Pensar nas coisas que vão acontecer antes do Armagedon pode motivar-nos a dar o nosso melhor no ministério",
                    "numero_ref": "1"
                },
                {
                    "tipo": "subtema",
                    "texto": "1. Ajude outros a sobreviver ao Armagedon"
                },
                {
                    "tipo": "paragrafo",
                    "texto": "Os israelitas que odiavam mesmo coisas erradas receberam um sinal simbólico para não serem destruídos. (Eze. 9:4; rr 173 § 6)",
                    "numero_ref": "2"
                },
                {
                    "tipo": "paragrafo",
                    "texto": "Os que não receberam o sinal morreram quando Jerusalém foi destruída. (Eze. 9:5, 6)",
                    "numero_ref": "3"
                },
                {
                    "tipo": "paragrafo",
                    "texto": "Até um pouco antes do Armagedon começar, podemos ajudar outros a servir a Jeová. (w25.08 31 §§ 1-2, 6)",
                    "numero_ref": "4"
                },
                {
                    "tipo": "subtema",
                    "texto": "2. Pérolas espirituais"
                },
                {
                    "tipo": "paragrafo",
                    "texto": "Eze. 9:9 — Porque é que Jeová incluiu a “casa de Israel” nesta mensagem de julgamento? (it-T “Cronologia” § 104)",
                    "numero_ref": "5"
                },
                {
                    "tipo": "paragrafo",
                    "texto": "Que pérolas espirituais encontrou na leitura da Bíblia desta semana?",
                    "numero_ref": "6"
                },
                {
                    "tipo": "subtema",
                    "texto": "3. Leitura da Bíblia"
                },
                {
                    "tipo": "paragrafo",
                    "texto": "Eze. 9:1-11 (th lição 5)",
                    "numero_ref": "7"
                },
                {
                    "tipo": "subtema",
                    "texto": "🌾 EMPENHE-SE NO MINISTÉRIO"
                },
                {
                    "tipo": "subtema",
                    "texto": "4. Iniciar conversas"
                },
                {
                    "tipo": "paragrafo",
                    "texto": "DE CASA EM CASA. Use um vídeo do Kit de Ferramentas de Ensino. (lmd lição 3 ponto 5)",
                    "numero_ref": "8"
                },
                {
                    "tipo": "subtema",
                    "texto": "5. Cultivar o interesse"
                },
                {
                    "tipo": "paragrafo",
                    "texto": "DE CASA EM CASA. Use um vídeo para responder a uma pergunta do morador. (lmd lição 9 ponto 5)",
                    "numero_ref": "9"
                },
                {
                    "tipo": "subtema",
                    "texto": "6. Explicar as suas crenças"
                },
                {
                    "tipo": "subtema",
                    "texto": "Demonstração. Use um vídeo da série Será Que Houve Um Projeto?, para ajudar um familiar a entender porque acredita na criação. (th lição 2)"
                },
                {
                    "tipo": "subtema",
                    "texto": "🐑 VIVER COMO CRISTÃOS"
                },
                {
                    "tipo": "subtema",
                    "texto": "Cântico 60"
                },
                {
                    "tipo": "subtema",
                    "texto": "7. Salve-se a si mesmo e aos que o escutam"
                },
                {
                    "tipo": "subtema",
                    "texto": "Discurso com participação da assistência."
                },
                {
                    "tipo": "paragrafo",
                    "texto": "Como é que podemos salvar-nos a nós mesmos e aos que nos escutam? Por prestarmos constante atenção à nossa conduta e ao nosso ensino. (1 Tim. 4:16) Para isso, temos de fortalecer a nossa fé e a nossa amizade com Jeová. Assim, vamos ter força espiritual para rejeitar a conduta deste mundo. Além disso, fazemos um esforço, de forma regular, para melhorar as nossas habilidades de ensino. Os nossos vídeos podem ajudar-nos a fazer isso.",
                    "numero_ref": "10"
                },
                {
                    "tipo": "paragrafo",
                    "texto": "Mostre o VÍDEO Uma História com Futuro — Ensinar com Filmes e Vídeos. Depois, pergunte:",
                    "numero_ref": "11"
                },
                {
                    "tipo": "paragrafo",
                    "texto": "Como é que a nossa organização tem usado filmes e vídeos para ensinar?",
                    "numero_ref": "12"
                },
                {
                    "tipo": "paragrafo",
                    "texto": "Que vídeos é que já tocaram o seu coração ou ajudaram a sua família?",
                    "numero_ref": "13"
                },
                {
                    "tipo": "paragrafo",
                    "texto": "De que maneiras é que podemos usar os vídeos no nosso ministério, e como é que podemos preparar-nos para usá-los?",
                    "numero_ref": "14"
                },
                {
                    "tipo": "subtema",
                    "texto": "8. Estudo bíblico de congregação"
                },
                {
                    "tipo": "paragrafo",
                    "texto": "wcg cap. 23",
                    "numero_ref": "15"
                },
                {
                    "tipo": "rodape",
                    "texto": "Comentários finais | Cântico 135 e oração"
                }
            ]
        }
