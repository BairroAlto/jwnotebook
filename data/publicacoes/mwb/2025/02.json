                },
                {
                    "tipo": "paragrafo",
                    "texto": "Leia Génesis 4:2-4 e Hebreus 11:4. Depois, pergunte:",
                    "numero_ref": "20"
                },
                {
                    "tipo": "paragrafo",
                    "texto": "Como é que Abel mostrou que era um amigo de Jeová?",
                    "numero_ref": "21"
                },
                {
                    "tipo": "paragrafo",
                    "texto": "Como é que Abel mostrou que era um amigo de Jeová?",
                    "numero_ref": "22"
                },
                {
                    "tipo": "paragrafo",
                    "texto": "O que é que ajudou Abel a ter fé em Jeová?",
                    "numero_ref": "23"
                },
                {
                    "tipo": "paragrafo",
                    "texto": "O que é que ajudou Abel a ter fé em Jeová?",
