{
  "manifest_version": 3,
  "name": "WOL para Gerador Manual MWB",
  "version": "1.0",
  "description": "Extrai artigos do WOL (wol.jw.org) e preenche automaticamente a aba ativa no Gerador Manual MWB.",
  "permissions": [
    "tabs",
    "activeTab"
  ],
  "host_permissions": [
    "https://wol.jw.org/*",
    "http://127.0.0.1/*",
    "http://localhost/*",
    "file:///*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://wol.jw.org/*"],
      "js": ["content_wol.js"],
      "css": ["content_wol.css"]
    },
    {
      "matches": [
        "http://127.0.0.1/*gerador_manual.html*",
        "http://localhost/*gerador_manual.html*",
        "file:///*gerador_manual.html*"
      ],
      "js": ["content_gerador.js"]
    }
  ]
}
